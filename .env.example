# ─────────────────────────────────────────────────────────────
# AlmanTec Viral Studio AI · configuración del servidor
# Copia este archivo como .env y rellénalo. NUNCA subas .env a GitHub.
# Las claves solo las lee el servidor: el navegador nunca las recibe.
# ─────────────────────────────────────────────────────────────

# Acceso privado (obligatorio en producción). Mínimo 10 caracteres.
APP_PASSWORD=
# Secreto para firmar la cookie de sesión. Genera uno con: openssl rand -hex 32
SESSION_SECRET=

NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Carpetas de datos (proyectos, vídeos, base de datos) y modelos locales.
DATA_DIR=./data
MODELS_DIR=./models

# Límites de subida
MAX_UPLOAD_MB=2048
MAX_FILES_PER_UPLOAD=20

# Días que se conservan originales y renders (0 = no borrar automáticamente).
RETENTION_DAYS=0

# 1 = el procesador de vídeos corre dentro del servidor web; 0 = lanza «npm run worker» aparte.
INLINE_WORKER=1
# Hilos de FFmpeg (0 = automático)
FFMPEG_THREADS=0

# ── Proveedores opcionales de pago (déjalos vacíos para usar solo lo local y gratuito) ──
# Claude (Anthropic): elige escenas, ordena la historia y redacta el pack de publicación.
# Recibe la transcripción y algunos fotogramas (imágenes), nunca el vídeo completo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ElevenLabs: voz en off más natural. Recibe solo el texto del guion.
# Usa voces de tu cuenta con licencia; no clones voces de personas sin su permiso.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_VOICE_MALE=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Carpeta con la fuente Inter para subtítulos (opcional; en Docker ya viene instalada).
# FONTS_DIR=/usr/share/fonts/opentype/inter
